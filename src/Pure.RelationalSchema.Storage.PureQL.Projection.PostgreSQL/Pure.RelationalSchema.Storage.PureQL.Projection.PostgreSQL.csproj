<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Pure.RelationalSchema.Storage.PureQL.Projection.PostgreSQL</PackageId>
    <RootNamespace>Pure.RelationalSchema.Storage.PureQL.Projection.PostgreSQL</RootNamespace>
    <AssemblyName>Pure.RelationalSchema.Storage.PureQL.Projection.PostgreSQL</AssemblyName>
    <Authors>Dmitry Kurochkin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/kudima03/Pure.RelationalSchema.Storage.PureQL.Projection.PostgreSQL</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="Linq.Expressions.Translation.PostgreSql"
      Version="0.1.0-preview.0.10.0"
    />
    <PackageReference Include="Pure.Collections.Generic" Version="0.1.0-preview.3.1.0" />
    <PackageReference Include="Pure.RelationalSchema.HashCodes" Version="3.4.0" />
    <PackageReference
      Include="Pure.RelationalSchema.Storage.PureQL.Projection"
      Version="0.1.0-preview.7.0.1"
    />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pure.RelationalSchema.Storage.PureQL.Projection.PostgreSQL.Tests" />
  </ItemGroup>
</Project>
